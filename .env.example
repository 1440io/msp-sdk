# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Check what a run would touch before running it:  npm run integration:preflight

# ── Credentials ───────────────────────────────────────────────────────────────
# Integration API key. Server-side credential; treat it like a password.
MSP_API_KEY=
# Host under test.
MSP_BASE_URL=https://1440.cloud
# Webhook signing secret, shown once when the integration was created.
MSP_WEBHOOK_SECRET=

# ── Tiers ─────────────────────────────────────────────────────────────────────
# Each tier is off by default. Turning one on is a deliberate act.

# Create and delete real records (template drafts, rich assets, permission
# sets, a temporary conversation rename). Everything is cleaned up afterwards.
MSP_TEST_ALLOW_WRITES=0

# DELIVERS REAL MESSAGES. A person may read them. Requires a conversation id.
MSP_TEST_ALLOW_SEND=0
MSP_TEST_CONVERSATION_ID=

# RINGS A REAL DEVICE with an Apple Messages request. Requires an E.164 number.
MSP_TEST_ALLOW_INITIATE=0
MSP_TEST_PHONE_NUMBER=

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Live end-to-end test: starts a local receiver and waits for a real delivery.
# Expose the port with a tunnel and point the integration endpoint at it first.
MSP_TEST_WEBHOOK_LIVE=0
MSP_TEST_WEBHOOK_PORT=3000
MSP_TEST_WEBHOOK_TIMEOUT_MS=120000

# ── Options ───────────────────────────────────────────────────────────────────
# Channel used where a test has to pick one.
MSP_TEST_CHANNEL=amb
# Fail, rather than warn, when a live response carries undocumented fields.
MSP_TEST_STRICT_SCHEMA=0
# Log every request and response.
MSP_TEST_VERBOSE=0
